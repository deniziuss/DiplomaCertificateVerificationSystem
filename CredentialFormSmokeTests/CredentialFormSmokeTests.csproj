<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../DiplomaCertificateVerificationSystem/Models/*.cs"
             Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../DiplomaCertificateVerificationSystem/Services/CredentialHashService.cs"
             Link="Services/CredentialHashService.cs" />
    <Compile Include="../DiplomaCertificateVerificationSystem/Forms/CredentialDetailsForm.cs"
             Link="Forms/CredentialDetailsForm.cs" />
    <Compile Include="../DiplomaCertificateVerificationSystem/Forms/CredentialDetailsForm.Designer.cs"
             Link="Forms/CredentialDetailsForm.Designer.cs" />
  </ItemGroup>
</Project>
